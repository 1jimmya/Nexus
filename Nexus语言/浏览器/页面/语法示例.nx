; 语法示例页
(rec "title" "Nexus 语法示例"
     "doc"
     (rec "type" "page"
          "children"
          [(rec "type" "heading" "level" 1 "text" "Nexus 语法示例")
           (rec "type" "text" "text" "Nexus 是前缀节点语言，代码与数据同形。下面是最常用的写法。")
           (rec "type" "card" "title" "函数与变量"
                "children"
                [(rec "type" "code" "text" "(node square (x) (* x x))\n(letv n 9)\n(square n)   ; 81")])
           (rec "type" "card" "title" "记录与列表"
                "children"
                [(rec "type" "code" "text" "(letv r (rec \"id\" \"FB-01\" \"battery\" 92))\n(get r \"battery\")\n(append [1 2] 3)")])
           (rec "type" "card" "title" "条件与循环"
                "children"
                [(rec "type" "code" "text" "(cond (> n 5) (then \"big\") (lest \"small\"))\n(letv i 0)\n(spin (< i 3) (rebind i (+ i 1)))\n(scan x [1 2 3] (print x))")])
           (rec "type" "card" "title" "错误处理"
                "children"
                [(rec "type" "code" "text" "(try (/ 1 0))   ; {ok:#f, kind:\"runtime\", ...}")])
           (rec "type" "row" "children"
                [(rec "type" "button" "text" "返回首页" "action" "goto:nexus://home")])
           (rec "type" "divider")
           (rec "type" "text" "text" "完整语法见 说明文档/语法手册.md" "tone" "dim")]))
