; 控制流：条件、循环、遍历、提前跳出
(node classify (x)
  (cond (> x 0) (then "positive")
        (== x 0) (then "zero")
        (lest "negative")))
(letv i 0)
(letv sum 0)
(spin (< i 5)
  (rebind sum (+ sum i))
  (rebind i (+ i 1)))
(letv out [])
(scan x [1 2 3 4 5]
  (cond (== x 4) (then (sever)))
  (rebind out (append out (* x 2))))
(rec "classify" (classify -3)
     "sum" sum
     "out" out)
